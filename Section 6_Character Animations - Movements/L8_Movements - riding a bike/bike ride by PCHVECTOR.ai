         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">bike ride by PCHVECTOR</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Happy young family riding bicycles in city park vector illustration. Cartoon smiling mom, dad and child cycling together. Healthy lifestyle, recreational activity and vacation concept</rdf:li>
            </rdf:Alt>
         </dc:description>
